{
  "name": "@snapforge/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic layout JSON → TSX renderer. Shared phone + desktop.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "forge": "tsx src/cli.ts"
  },
  "dependencies": {
    "ajv": "^6.15.0",
    "ajv-formats": "^3.0.1",
    "fast-json-patch": "^3.1.1",
    "typescript": "~5.6.0"
  },
  "devDependencies": {
    "@snapforge/schema": "*",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  }
}
