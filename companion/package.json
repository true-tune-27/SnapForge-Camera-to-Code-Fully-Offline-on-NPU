{
  "name": "@snapforge/companion",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop companion CLI — indexer, watcher, landing service, Office Kit bridge",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "snapforge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:bridge": "vitest run --reporter=verbose test/bridge.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@snapforge/renderer": "^0.1.0",
    "chokidar": "^5.0.0",
    "isomorphic-git": "^1.42.2",
    "ts-morph": "^28.0.0",
    "typescript": "~5.6.0"
  },
  "devDependencies": {
    "@snapforge/schema": "*",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  }
}
