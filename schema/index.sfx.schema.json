{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapforge.dev/schema/index.sfx.json",
  "title": "SnapForge Design System Index",
  "description": "The compact map of the user's repo sent to the phone. ~40-120 KB gzipped. Generated by the companion CLI, never leaves the local link.",
  "type": "object",
  "required": ["repo", "components", "tokens", "conventions"],
  "additionalProperties": false,
  "properties": {
    "repo": {
      "$ref": "#/$defs/Repo"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Component"
      }
    },
    "tokens": {
      "$ref": "#/$defs/Tokens"
    },
    "conventions": {
      "$ref": "#/$defs/Conventions"
    }
  },
  "$defs": {
    "Repo": {
      "type": "object",
      "required": ["name", "framework", "indexedAt"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Repository name, e.g. 'acme-web'"
        },
        "framework": {
          "type": "string",
          "description": "Framework identifier, e.g. 'react-ts'"
        },
        "indexedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the index was generated"
        }
      }
    },
    "Component": {
      "type": "object",
      "required": ["name", "import", "export", "props", "maps", "usageCount"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Exported identifier, e.g. 'Card'"
        },
        "import": {
          "type": "string",
          "description": "Import path using the repo's alias, e.g. '@/components/ui/card'"
        },
        "export": {
          "enum": ["named", "default"],
          "description": "Whether the component uses named or default export"
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Prop"
          }
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z_]+$",
            "description": "role.variant keys this component can serve, e.g. 'container.card'"
          },
          "description": "Layout role.variant keys this component maps to. Used by the resolver for lookup."
        },
        "usageCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of JSX usages across the repo. Used to break resolver ties — the component the team actually uses wins."
        }
      }
    },
    "Prop": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Prop name as declared in the component"
        },
        "type": {
          "type": "string",
          "description": "TypeScript type as written, e.g. 'SpaceToken', 'boolean', 'string'"
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "Whether the prop is optional (?)"
        }
      }
    },
    "TokenScale": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Named scale mapping token names to pixel values, e.g. { '1': 4, '2': 8, '4': 16 }"
    },
    "ColorScale": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Named colour tokens, e.g. { 'primary': '#3b82f6' }"
    },
    "Tokens": {
      "type": "object",
      "required": ["space", "radius"],
      "additionalProperties": false,
      "properties": {
        "space": {
          "$ref": "#/$defs/TokenScale"
        },
        "radius": {
          "$ref": "#/$defs/TokenScale"
        },
        "color": {
          "$ref": "#/$defs/ColorScale"
        }
      }
    },
    "Conventions": {
      "type": "object",
      "required": ["screenDir", "fileCase", "ext", "exportStyle", "styleSystem", "importAlias"],
      "additionalProperties": false,
      "properties": {
        "screenDir": {
          "type": "string",
          "description": "Directory where screen/page files live, e.g. 'src/screens'"
        },
        "fileCase": {
          "enum": ["PascalCase", "kebab-case", "camelCase"],
          "description": "File naming convention, determined by majority of existing filenames"
        },
        "ext": {
          "enum": [".tsx", ".jsx"],
          "description": "File extension, determined by majority of existing component files"
        },
        "exportStyle": {
          "enum": ["named", "default"],
          "description": "Predominant export style in the repo"
        },
        "styleSystem": {
          "enum": ["tokens-prop", "tailwind", "css-modules", "styled-components"],
          "description": "Styling approach detected from component imports"
        },
        "importAlias": {
          "type": "string",
          "description": "Path alias from tsconfig, e.g. '@/'"
        }
      }
    }
  }
}
