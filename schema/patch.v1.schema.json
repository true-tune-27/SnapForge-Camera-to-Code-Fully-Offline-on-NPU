{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapforge.dev/schema/patch.v1.json",
  "title": "SnapForge Voice Edit Patch",
  "description": "RFC 6902 JSON-Patch document emitted by the edit model",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["op", "path"],
    "properties": {
      "op": {
        "enum": ["add", "remove", "replace", "move", "copy", "test"]
      },
      "path": {
        "type": "string"
      },
      "value": {},
      "from": {
        "type": "string"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "op": { "enum": ["add", "replace", "test"] } },
          "required": ["op"]
        },
        "then": { "required": ["value"] }
      },
      {
        "if": {
          "properties": { "op": { "enum": ["move", "copy"] } },
          "required": ["op"]
        },
        "then": { "required": ["from"] }
      }
    ]
  }
}
